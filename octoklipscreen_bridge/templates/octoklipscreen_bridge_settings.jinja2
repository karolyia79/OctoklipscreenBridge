<div id="settings_plugin_octoklipscreen_bridge">
    <!-- Tab Navigation -->
    <ul class="nav nav-tabs">
        <li class="active"><a href="#settings_octoklipscreen_bridge_mqtt" data-toggle="tab">MQTT Settings</a></li>
        <li><a href="#settings_octoklipscreen_bridge_stats" data-toggle="tab">Statistics & Materials</a></li>
        <li><a href="#settings_octoklipscreen_bridge_api" data-toggle="tab">API Documentation</a></li>
    </ul>

    <div class="tab-content">
        <!-- 1. TAB: MQTT SETTINGS -->
        <div class="tab-pane active" id="settings_octoklipscreen_bridge_mqtt">
            <form class="form-horizontal">
                <div class="control-group">
                    <label class="control-label" for="settings-octoklipscreen_bridge-mqtt-host">MQTT Host:</label>
                    <div class="controls">
                        <input type="text" id="settings-octoklipscreen_bridge-mqtt-host" class="input-large" data-bind="value: settings.plugins.octoklipscreen_bridge.mqtt_host" placeholder="localhost">
                        <span class="help-block">IP address or hostname of your MQTT broker</span>
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="settings-octoklipscreen_bridge-mqtt-port">MQTT Port:</label>
                    <div class="controls">
                        <input type="number" id="settings-octoklipscreen_bridge-mqtt-port" class="input-small" data-bind="value: settings.plugins.octoklipscreen_bridge.mqtt_port" placeholder="1883" min="1" max="65535">
                        <span class="help-block">MQTT broker port (default: 1883)</span>
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="settings-octoklipscreen_bridge-mqtt-username">MQTT Username:</label>
                    <div class="controls">
                        <input type="text" id="settings-octoklipscreen_bridge-mqtt-username" class="input-large" data-bind="value: settings.plugins.octoklipscreen_bridge.mqtt_username" placeholder="(optional)">
                        <span class="help-block">Leave empty if authentication is not required</span>
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="settings-octoklipscreen_bridge-mqtt-password">MQTT Password:</label>
                    <div class="controls">
                        <input type="password" id="settings-octoklipscreen_bridge-mqtt-password" class="input-large" data-bind="value: settings.plugins.octoklipscreen_bridge.mqtt_password" placeholder="(optional)">
                        <span class="help-block">Leave empty if authentication is not required</span>
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="settings-octoklipscreen_bridge-mqtt-topic">MQTT Topic:</label>
                    <div class="controls">
                        <input type="text" id="settings-octoklipscreen_bridge-mqtt-topic" class="input-large" data-bind="value: settings.plugins.octoklipscreen_bridge.mqtt_topic" placeholder="octoprint/serial">
                        <span class="help-block" style="color: #b94a48; font-weight: bold;">DO NOT CHANGE! This topic structure is strictly required for the CYD display firmware compatibility.</span>
                    </div>
                </div>

                <div class="alert alert-error" style="background-color: #f2dede; border-color: #ebccd1; color: #a94442;">
                    <strong>IMPORTANT (Maximum Stability):</strong><br>
                    For maximum stability and zero latency, it is highly recommended to run a dedicated local Mosquitto MQTT broker directly on the OctoPrint server (<code>localhost</code>)!
                </div>

                <div class="alert alert-info">
                    <strong>Octoklipscreen Bridge Overview:</strong><br>
                    This plugin bridges your OctoPrint server with the CYD (Cheap Yellow Display) touchscreen firmware, enabling real-time status monitoring and G-code control via MQTT.<br><br>
                    <strong>Active MQTT Topics:</strong>
                    <ul style="margin-bottom: 0; margin-top: 5px;">
                        <li><code>{base_topic}/serial</code> – Real-time G-code communication logs (Send / Recv).</li>
                        <li><code>{base_topic}/status</code> – Printer and connection status updates with retained messages. Automatically refreshed every 15 seconds or instantly upon receiving a <code>STATUS</code> command.</li>
                        <li><code>{base_topic}/command</code> – Incoming control commands, G-code execution, and status request queries.</li>
                    </ul>
                </div>
            </form>
        </div>

        <!-- 2. TAB: STATISTICS & MATERIALS SETTINGS -->
        <div class="tab-pane" id="settings_octoklipscreen_bridge_stats">
            <form class="form-horizontal">
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" id="octoklipscreen_stat_enabled"> Enable statistics collection
                        </label>
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="octoklipscreen_stat_currency">Currency Symbol:</label>
                    <div class="controls">
                        <input type="text" id="octoklipscreen_stat_currency" class="input-small" placeholder="Ft">
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="octoklipscreen_stat_cost">Electricity Cost (per kWh):</label>
                    <div class="controls">
                        <input type="number" id="octoklipscreen_stat_cost" class="input-small" step="0.1">
                    </div>
                </div>

                <div class="control-group">
                    <label class="control-label" for="octoklipscreen_stat_power">Average Printer Power (W):</label>
                    <div class="controls">
                        <input type="number" id="octoklipscreen_stat_power" class="input-small" step="1">
                    </div>
                </div>

                <hr>
                <h4>Material Temperature Ranges (Min - Max)</h4>
                <table class="table table-striped table-bordered" style="max-width: 700px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Nozzle Min</th>
                            <th>Nozzle Max</th>
                            <th>Bed Min</th>
                            <th>Bed Max</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="octoklipscreen_materials_table_body">
                        <!-- Dynamic rows -->
                    </tbody>
                </table>
                <button type="button" class="btn" id="octoklipscreen_add_material_btn">+ Add New Material</button>
                
                <div style="margin-top: 20px;">
                    <button type="button" class="btn btn-primary" id="octoklipscreen_save_stats_btn">Save Statistics Settings</button>
                    <button type="button" class="btn btn-info" id="octoklipscreen_reload_stats_btn">Reload Settings</button>
                    <button type="button" class="btn btn-danger" id="octoklipscreen_reset_stats_btn" style="float: right;">Reset All Statistics</button>
                </div>
            </form>
        </div>

        <!-- 3. TAB: API DOCUMENTATION & EXAMPLES -->
        <div class="tab-pane" id="settings_octoklipscreen_bridge_api">
            <div class="alert alert-info">
                <h4>Octoklipscreen Bridge - REST API Documentation</h4>
                <p>The server-side statistics module provides dedicated REST API endpoints allowing external devices (e.g., ESP32 displays, web interfaces, custom scripts) to fetch aggregated statistics, update configurations, or reset logged data.</p>
            </div>

            <h5>1. Fetch Statistics Data (GET)</h5>
            <pre><code>GET /plugin/octoklipscreen_bridge/stats/data</code></pre>

            <h5>2. Save Configuration (POST)</h5>
            <pre><code>POST /plugin/octoklipscreen_bridge/stats/save</code></pre>

            <h5>3. Reset Statistics (POST)</h5>
            <pre><code>POST /plugin/octoklipscreen_bridge/stats/reset</code></pre>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function() {
        // Blueprint szerinti elérés (nincs /api/ prefix)
        var apiBase = (typeof BASEURL !== "undefined" ? BASEURL : "/") + "plugin/octoklipscreen_bridge/stats";

        function addMatRow(name, nmin, nmax, bmin, bmax) {
            name = name || "";
            nmin = nmin !== undefined ? nmin : 180;
            nmax = nmax !== undefined ? nmax : 220;
            bmin = bmin !== undefined ? bmin : 40;
            bmax = bmax !== undefined ? bmax : 60;

            var tbody = $("#octoklipscreen_materials_table_body");
            var tr = $("<tr></tr>");
            
            tr.append($("<td>").append($("<input>", { type: "text", class: "m_name input-small", value: name })));
            tr.append($("<td>").append($("<input>", { type: "number", class: "m_nmin input-mini", value: nmin })));
            tr.append($("<td>").append($("<input>", { type: "number", class: "m_nmax input-mini", value: nmax })));
            tr.append($("<td>").append($("<input>", { type: "number", class: "m_bmin input-mini", value: bmin })));
            tr.append($("<td>").append($("<input>", { type: "number", class: "m_bmax input-mini", value: bmax })));
            
            var delBtn = $("<button>", { type: "button", class: "btn btn-danger btn-mini", text: "X" });
            delBtn.on("click", function() { $(this).closest("tr").remove(); });
            tr.append($("<td>").append(delBtn));
            
            tbody.append(tr);
        }

        function populateTable(materials) {
            var tbody = $("#octoklipscreen_materials_table_body");
            tbody.empty();
            if (materials && materials.length > 0) {
                $.each(materials, function(index, m) {
                    addMatRow(m.name, m.n_min, m.n_max, m.b_min, m.b_max);
                });
            }
        }

        function loadStatsSettings(showNotification) {
            $.ajax({
                url: apiBase + "/data",
                type: "GET",
                dataType: "json",
                success: function(data) {
                    var cfg = (data && data.config !== undefined) ? data.config : data;
                    
                    if (cfg && cfg.materials) {
                        $("#octoklipscreen_stat_enabled").prop("checked", cfg.enabled);
                        $("#octoklipscreen_stat_currency").val(cfg.currency || "Ft");
                        $("#octoklipscreen_stat_cost").val(cfg.cost_kwh || 5.0);
                        $("#octoklipscreen_stat_power").val(cfg.power_w || 250.0);
                        populateTable(cfg.materials);
                        
                        if (showNotification) {
                            new PNotify({title: "Frissítve", text: "Adatok sikeresen újratöltve!", type: "info"});
                        }
                    } else {
                        populateTable([]);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Nem sikerült lekérni a statisztikai JSON-t:", error);
                    if (showNotification) {
                        new PNotify({title: "Hiba", text: "Nem sikerült lekérni az adatokat!", type: "error"});
                    }
                }
            });
        }

        // Gombkezelők delegálva
        $(document).off("click", "#octoklipscreen_add_material_btn").on("click", "#octoklipscreen_add_material_btn", function(e) {
            e.preventDefault();
            addMatRow("Új anyag", 180, 220, 40, 60);
        });

        $(document).off("click", "#octoklipscreen_save_stats_btn").on("click", "#octoklipscreen_save_stats_btn", function(e) {
            e.preventDefault();
            var materials = [];
            $("#octoklipscreen_materials_table_body tr").each(function() {
                var r = $(this);
                materials.push({
                    name: r.find(".m_name").val(),
                    n_min: parseFloat(r.find(".m_nmin").val()) || 0,
                    n_max: parseFloat(r.find(".m_nmax").val()) || 0,
                    b_min: parseFloat(r.find(".m_bmin").val()) || 0,
                    b_max: parseFloat(r.find(".m_bmax").val()) || 0
                });
            });

            var payload = {
                enabled: $("#octoklipscreen_stat_enabled").is(":checked"),
                currency: $("#octoklipscreen_stat_currency").val() || "Ft",
                cost_kwh: parseFloat($("#octoklipscreen_stat_cost").val()) || 0,
                power_w: parseFloat($("#octoklipscreen_stat_power").val()) || 0,
                materials: materials
            };

            $.ajax({
                url: apiBase + "/save",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function() {
                    new PNotify({title: "Sikeres mentés", text: "Statisztika és anyagok elmentve!", type: "success"});
                },
                error: function() {
                    new PNotify({title: "Hiba", text: "Nem sikerült menteni a beállításokat!", type: "error"});
                }
            });
        });

        $(document).off("click", "#octoklipscreen_reload_stats_btn").on("click", "#octoklipscreen_reload_stats_btn", function(e) {
            e.preventDefault();
            loadStatsSettings(true);
        });

        $(document).off("click", "#octoklipscreen_reset_stats_btn").on("click", "#octoklipscreen_reset_stats_btn", function(e) {
            e.preventDefault();
            if(confirm("Biztosan törölni akarod az eddigi statisztikákat?")) {
                $.ajax({
                    url: apiBase + "/reset",
                    type: "POST",
                    success: function() {
                        new PNotify({title: "Törölve", text: "Statisztikai (CSV) adatok kiürítve!", type: "success"});
                    },
                    error: function() {
                        new PNotify({title: "Hiba", text: "Nem sikerült törölni az adatokat!", type: "error"});
                    }
                });
            }
        });

        $(document).on('shown', 'a[data-toggle="tab"]', function (e) {
            if ($(e.target).attr('href') === '#settings_octoklipscreen_bridge_stats') {
                loadStatsSettings(false);
            }
        });

        setTimeout(function() { loadStatsSettings(false); }, 1000);
    });
</script>
